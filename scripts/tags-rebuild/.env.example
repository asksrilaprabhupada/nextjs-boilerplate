# Copy to scripts/tags-rebuild/.env (git-ignored) and fill in. The harness reads
# ONLY this file (+ the process environment, which wins). ALL five keys below are
# required — there is no anon-key fallback and no degraded mode.

SUPABASE_URL=https://wzktlpjtqmjxvragwhqg.supabase.co
SUPABASE_SERVICE_KEY=            # service_role secret — NEVER the anon key
# Supabase **Session Pooler** DSN (Project Settings → Database → Connection string
# → Session pooler). Must be the 5432 session pooler, not the 6543 transaction
# pooler: backfills, vector reads and CREATE INDEX CONCURRENTLY need real sessions.
DATABASE_URL=postgresql://postgres.wzktlpjtqmjxvragwhqg:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
GEMINI_API_KEY=                  # Google AI Studio key (Batch API access)
VOYAGE_API_KEY=                  # vocabulary term embeddings (voyage-context-4)

# ── Cost ceiling (machine-enforced; approved budget 380) ────────────────────
# ONE ceiling for BOTH pipelines: the tagging harness (config.py) and
# questions_run.py read this same variable and pin the same 380 default. Declare
# it exactly once — a second MAX_SPEND_USD line later in this file silently wins
# for both.
MAX_SPEND_USD=380
# Per-model Gemini Batch price sheet. The CANONICAL map ships in config.py
# (GEMINI_BATCH_PRICES_CANONICAL: gemini-3.5-flash 0.75/4.50 · gemini-3-flash-
# preview 0.25/1.50) — `--doctor` FAILS if any ROUTED model lacks a pinned
# price, a price is <=0/stale, or the effective prices differ from the map.
# Per-model overrides use the model-suffixed convention below; the un-suffixed
# legacy vars still override gemini-3.5-flash only. Overrides must be mirrored
# into the canonical map in lock-step (cost counts candidates + thinking).
#GEMINI_BATCH_PRICE_IN_PER_M__GEMINI_3_5_FLASH=0.75
#GEMINI_BATCH_PRICE_OUT_PER_M__GEMINI_3_5_FLASH=4.50
#GEMINI_BATCH_PRICE_IN_PER_M__GEMINI_3_FLASH_PREVIEW=0.25
#GEMINI_BATCH_PRICE_OUT_PER_M__GEMINI_3_FLASH_PREVIEW=1.50
#GEMINI_BATCH_PRICE_IN_PER_M=0.75    # legacy alias — gemini-3.5-flash only
#GEMINI_BATCH_PRICE_OUT_PER_M=4.50   # legacy alias — gemini-3.5-flash only

# ── Models (v3.p3-hybrid routing; confirmed against models.list before any run)
# core     = verses + verse_chunks of bg/sb/cc  → MODEL_CORE
# standard = everything else                    → MODEL_STANDARD
#MODEL_CORE=gemini-3.5-flash
#MODEL_STANDARD=gemini-3-flash-preview
#GEMINI_MODEL=gemini-3.5-flash   # DEPRECATED alias for MODEL_CORE

# ── Optional dials (defaults in config.py) ──────────────────────────────────
# NOTE: thinkingLevel is NO LONGER an env knob — it is pinned to LOW in code
# for BOTH models (gemini-3-flash-preview defaults to HIGH thinking; the
# explicit LOW override is mandatory and non-overridable).
#MAX_OUTPUT_TOKENS=8192          # SAFETY ceiling only; temperature is model-default
#MAX_TAGS=12
#MAX_QUESTIONS=3                 # 0-3 questions per passage; zero is valid
#SHORTLIST_SEMANTIC=25           # semantic lane of the candidate union
#SHORTLIST_CAP=40                # union cap (hard-negative partners added back)
#SHARD_SIZE=6000
#SHARD_MAX_INPUT_TOKENS=400000   # per-job input-token cap (renamed from MAX_SHARD_INPUT_TOKENS);
                                 # small so ~6 jobs share the 3M enqueued-batch-token queue
                                 # concurrently instead of one giant shard blocking it
#PILOT_SIZE=2000                 # EXACT pilot manifest size
#PILOT_SUCCESS_SLICE=200         # p1 successes re-tagged for comparison
#PILOT_LENGTH_BANDS=4            # length quartiles for the fresh-stratum stratification
#SAMPLE_SEED=asp-tags-v3.p3      # seed for every sampling decision (recorded in reports)
#BAKEOFF_SAMPLE_QUESTIONS=25     # side-by-side question samples in the bakeoff report

# ── v4-tiered: three-tier classifier (defaults in config.py) ────────────────
# PURE_CLASSIFICATION=1 (default) selects the v4 pipeline: Tier 1 exact aliases +
# Tier 2 embedding shortlist (both free) + Tier 3 LLM judge (paid). Set to 0 to
# fall back to the legacy generative pass. Questions + passage_function are
# DEFERRED regardless (no generation now).
#PURE_CLASSIFICATION=1
#TIER2_SHORTLIST_K=12           # Concept/Practice shortlist depth per passage (pilot width)
#TIER2_SHORTLIST_K_FULL=20      # full-run shortlist width (recalibrated at full-run start;
                                # measured recall ceiling k12=0.719 → k20=0.823)
#TIER2_ACCEPT=0.47              # DIAGNOSTIC precision head only — v4-tiered.2 removed
                                # the auto-accept band; nothing is auto-assigned
#TIER2_REJECT=0.22              # < → auto-drop; ≥ (or a lexical hit) → the judge
#TIER2_TARGET_ACCEPT_PRECISION=0.80   # calibration rule: min precision for T_accept (diagnostic)
#TIER2_TARGET_REJECT_RECALL=0.95      # calibration rule: min in-shortlist recall kept
#P1_PILOT_RUN_ID=63c99428-7ecb-469d-a551-cc99f9585673   # calibration ground truth + exemplar source
# v4-tiered.2 candidate union + exemplar lanes:
#TIER3_CANDIDATE_CAP=25         # cap on the union(top-K label ∪ top-K exemplar ∪ lexical)
#TIER3_EXEMPLARS_PER_TERM=5     # p1-accepted passage embeddings cached per C/P term
#TIER3_RECALL_CEILING_K=20      # K for the reported union-vs-label recall ceiling
# TIERED Tier-3 output caps by ladder attempt (first / retry / gemini-3.5-flash escalation):
#TIER3_MAX_OUTPUT_TOKENS=2048            # attempt 1 (first pass)
#TIER3_MAX_OUTPUT_TOKENS_RETRY=4096      # attempt 2 (same-model retry)
#TIER3_MAX_OUTPUT_TOKENS_ESCALATION=8192 # attempt 3 (escalation; quarantine only after this fails)
# ── questions_run.py — `questions` + `passage_function` + `speaker` ─────────
# A SEPARATE pipeline from the tagging harness above: its own run tables, its own
# shard files and its own cost ledger. Two routed models cover all 244,148 rows:
#   gemini-3.6-flash  verses + verse_chunks in BG/SB/CC        43,232 rows
#   gemini-3-flash    everything else                         200,916 rows
# NOTE gemini-3.6-flash no longer accepts temperature/top_p/top_k (ignored) and
# RAISES on frequency/presence penalties — questions_run.py sends NONE of them
# for either model, and tests/test_questions_run.py asserts that.
#QUESTIONS_MODEL_36=gemini-3.6-flash
#QUESTIONS_MODEL_3=gemini-3-flash
# BATCH prices per 1M tokens (already halved vs interactive). The OUT price
# applies to THINKING tokens too — the ledger counts candidates + thoughts.
GEMINI_36_PRICE_IN_PER_M=0.75
GEMINI_36_PRICE_OUT_PER_M=3.75
GEMINI_3_PRICE_IN_PER_M=0.25
GEMINI_3_PRICE_OUT_PER_M=1.50
# Machine-enforced ceiling, checked before EVERY shard submission: set ONCE at
# the top of this file (MAX_SPEND_USD=380) and shared with the tagging harness.
#QUESTIONS_PILOT_SIZE=2000              # STEP 2 billing pilot (~$3, mandatory)
#QUESTIONS_PILOT_AUTO_CONTINUE_USD=360  # extrapolated full-run cost that auto-continues
#QUESTIONS_PASSAGE_CHAR_CAP=6000        # every truncation is logged + counted
#QUESTIONS_SAMPLE_SEED=asp-questions-v1 # seeded, reproducible pilot manifest
#QUESTIONS_SHARD_SIZE=6000
#QUESTIONS_MAX_OUTPUT_TOKENS=4096
#   python questions_run.py              # pilot → gate → full → fts → report
#   python questions_run.py --resume     # continue after closing the laptop
#   python questions_run.py --verify     # assertions only, no API calls

# Run the full tiered pilot on the existing 2,000-row manifest, then STOP:
#   python run_all.py --pilot-only
# Run just the pilot (validate files → retry once → escalate standard rows once →
# apply on 100% row-level validity + gates → stop):
#   python run_all.py --pilot-only
# No-DB-write model bakeoff over the banked p2 pilot (maintainer-local files):
#   python run_all.py --bakeoff-model gemini-3-flash-preview --bakeoff-route standard
